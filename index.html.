<script>
'use strict';
const $ = id => document.getElementById(id);
const API = 'https://graphql.anilist.co';
let animeData = [];
let featuredRoomAnime = [];
let featuredRoomCharacters = [];
let featuredRoomCharactersByAnime = {};
let featuredOnePiece = null;
let searchTimer = null;
let currentRoomCode = null;
let apiBusy = false;

function showPage(page, button){
  document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===page));
  document.querySelectorAll('.nav-btn,.bottom-nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
  if(page==='rooms') renderRooms();
  if(page==='profile') loadProfile();
  if(page==='watch') renderChat();
  window.scrollTo(0,0);
}
function runTopSearch(){const value=$('topSearch').value.trim();showPage('explore');$('animeSearch').value=value;searchAnime();}

// AniList : une requête groupée pour limiter les appels réseau.
async function aniListRequest(query,variables={}){
  const response=await fetch(API,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({query,variables})});
  if(!response.ok) throw new Error('Service AniList indisponible (HTTP '+response.status+').');
  const json=await response.json();
  if(json.errors?.length) throw new Error(json.errors[0].message||'Erreur AniList.');
  return json.data;
}
const mediaFields=`id title { romaji english native } coverImage { extraLarge large } bannerImage averageScore episodes seasonYear format genres description`;
async function loadRoomFeaturedAnimes(){
  // Recherche des titres demandés dans le catalogue AniList : aucune affiche générée ou inventée.
  const query=`query($a:String,$b:String,$c:String,$d:String,$hero:String){
    apothecary:Page(page:1,perPage:5){media(search:$a,type:ANIME,isAdult:false,sort:SEARCH_MATCH){${mediaFields}}}
    steel:Page(page:1,perPage:5){media(search:$b,type:ANIME,isAdult:false,sort:SEARCH_MATCH){${mediaFields}}}
    firefly:Page(page:1,perPage:5){media(search:$c,type:ANIME,isAdult:false,sort:SEARCH_MATCH){${mediaFields}}}
    tokyo:Page(page:1,perPage:5){media(search:$d,type:ANIME,isAdult:false,sort:SEARCH_MATCH){${mediaFields}}}
    hero:Page(page:1,perPage:5){media(search:$hero,type:ANIME,isAdult:false,sort:SEARCH_MATCH){${mediaFields}}}
  }`;
  const data=await aniListRequest(query,{a:'The Apothecary Diaries',b:'Steel Ball Run',c:'Firefly Wedding',d:'Tokyo Revengers War of the Three Titans Arc',hero:'One Piece'});
  const normalize=m=>m?({id:m.id,title:m.title?.english||m.title?.romaji||m.title?.native||'Anime',image:m.coverImage?.extraLarge||m.coverImage?.large||'',banner:m.bannerImage||'',score:m.averageScore||0,episodes:m.episodes,year:m.seasonYear||'',format:m.format||'',genres:m.genres||[],description:(m.description||'').replace(/<br\s*\/?\s*>/gi,' ').replace(/<[^>]*>/g,' ')}):null;
  const first=(key,accept)=>(data[key]?.media||[]).find(m=>(m?.coverImage?.large||m?.coverImage?.extraLarge)&&accept((m.title?.english||'')+' '+(m.title?.romaji||'')+' '+(m.title?.native||'')));
  featuredRoomAnime=[
    normalize(first('apothecary',t=>/apothecary diaries|kusuriya/i.test(t))),
    normalize(first('steel',t=>/steel ball run/i.test(t))),
    normalize(first('firefly',t=>/firefly wedding/i.test(t))),
    normalize(first('tokyo',t=>/tokyo revengers/i.test(t)&&/three titans|war of the three/i.test(t)))
  ];
  const hero=normalize(first('hero'));
  featuredOnePiece=hero;
  // Récupère de vrais portraits de personnages pour composer l'Univers Shadow.
  featuredRoomCharacters=[];
  featuredRoomCharactersByAnime={};
  const characterTitles=featuredRoomAnime.map((anime,index)=>({anime,index})).filter(item=>item.anime);
  if(characterTitles.length){
    try{
      const characterFields=characterTitles.map((item,i)=>`c${i}:Media(id:${Number(item.anime.id)},type:ANIME){characters(page:1,perPage:2,sort:ROLE){nodes{name{full}image{large}}}}`).join(' ');
      const characterData=await aniListRequest(`query{${characterFields}}`);
      characterTitles.forEach((item,i)=>{
        const a=item.anime;
        const nodes=characterData['c'+i]?.characters?.nodes||[];
        featuredRoomCharactersByAnime[item.index]=nodes.filter(ch=>ch?.image?.large).map(ch=>({name:ch.name?.full||a.title,anime:a.title,image:ch.image.large}));
        featuredRoomCharacters.push(...featuredRoomCharactersByAnime[item.index]);
      });
    }catch(e){ console.warn('Portraits de personnages indisponibles',e); }
  }
  const heading=document.querySelector('.rooms-heading');
  if(heading&&hero?.image)heading.style.setProperty('--room-hero-image','url("'+hero.image.replace(/"/g,'%22')+'")');
  renderRoomAnimeMosaic();
}
async function loadAnimes(){
  const query=`query { trending: Page(page:1,perPage:10){ media(type:ANIME,sort:TRENDING_DESC,isAdult:false){ ${mediaFields} } } popular: Page(page:1,perPage:10){ media(type:ANIME,sort:POPULARITY_DESC,isAdult:false){ ${mediaFields} } } recent: Page(page:1,perPage:10){ media(type:ANIME,sort:START_DATE_DESC,isAdult:false){ ${mediaFields} } } }`;
  try{
    const data=await aniListRequest(query);
    const normalize=list=>(list||[]).filter(Boolean).map(m=>({id:m.id,title:m.title?.english||m.title?.romaji||m.title?.native||'Anime sans titre',image:m.coverImage?.extraLarge||m.coverImage?.large||'',banner:m.bannerImage||'',score:m.averageScore||0,episodes:m.episodes,year:m.seasonYear||'',format:m.format||'',genres:m.genres||[],description:(m.description||'').replace(/<br\s*\/?>/gi,' ').replace(/<[^>]*>/g,' ').replace(/&amp;/g,'&').replace(/&#039;/g,"'").replace(/&quot;/g,'"')}));
    const trending=normalize(data.trending.media),popular=normalize(data.popular.media),recent=normalize(data.recent.media);
    animeData=[...new Map([...trending,...popular,...recent].map(a=>[a.id,a])).values()];
    renderAnimeGrid('homeAnime',trending);
    renderAnimeGrid('newAnime',recent);
    renderRoomAnimeMosaic();
    loadRoomFeaturedAnimes().catch(()=>{});
    if($('roomList'))renderRooms();
  }catch(error){
    const message='Impossible de charger le catalogue. Vérifie ta connexion puis réessaie.';
    $('homeAnime').innerHTML='';$('newAnime').innerHTML='';
    showEmpty('homeAnime',message,true);showEmpty('newAnime',message,true);
  }
}
function showEmpty(id,message,retry=false){const box=document.createElement('div');box.className='empty';box.style.gridColumn='1/-1';box.textContent=message;if(retry){const btn=document.createElement('button');btn.className='btn secondary';btn.textContent='Réessayer';btn.onclick=loadAnimes;box.append(document.createElement('br'),btn)}$(id).replaceChildren(box)}
function renderAnimeGrid(containerId,list){
  const container=$(containerId);container.replaceChildren();
  if(!list?.length){showEmpty(containerId,'Aucun anime à afficher.');return}
  list.forEach((anime,index)=>{
    const card=document.createElement('article');card.className='anime-card';card.tabIndex=0;card.setAttribute('role','button');card.setAttribute('aria-label','Voir '+anime.title);card.onclick=()=>openAnime(anime);
    card.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openAnime(anime)}};
    const poster=document.createElement('div');poster.className='poster';
    const img=document.createElement('img');img.loading='lazy';img.alt='Affiche de '+anime.title;img.src=anime.image;img.onerror=()=>{img.style.display='none';poster.textContent='Affiche indisponible'};poster.append(img);
    const rank=document.createElement('span');rank.className='rank';rank.textContent='#'+(index+1);poster.append(rank);
    const info=document.createElement('div');info.className='anime-info';const title=document.createElement('strong');title.textContent=anime.title;const meta=document.createElement('small');meta.textContent=[anime.year,anime.format].filter(Boolean).join(' • ')||'Anime';const rating=document.createElement('small');rating.className='rating';rating.textContent=anime.score?'★ '+(anime.score/10).toFixed(1)+'/10':'Note non disponible';info.append(title,meta,rating);card.append(poster,info);container.append(card);
  });
}
async function searchAnime(){
  const term=$('animeSearch').value.trim();clearTimeout(searchTimer);
  if(!term){$('animeResults').innerHTML='<div class="empty">Tape un titre pour rechercher dans le catalogue.</div>';return}
  searchTimer=setTimeout(()=>performSearch(term),550);
}
async function performSearch(term){
  $('animeResults').innerHTML='<div class="loading"><span class="spinner"></span>Recherche en cours…</div>';
  const query=`query($search:String){Page(page:1,perPage:24){media(search:$search,type:ANIME,isAdult:false,sort:SEARCH_MATCH){${mediaFields}}}}`;
  try{const data=await aniListRequest(query,{search:term});const results=data.Page.media.map(m=>({id:m.id,title:m.title?.english||m.title?.romaji||m.title?.native||'Anime sans titre',image:m.coverImage?.extraLarge||m.coverImage?.large||'',banner:m.bannerImage||'',score:m.averageScore||0,episodes:m.episodes,year:m.seasonYear||'',format:m.format||'',genres:m.genres||[],description:(m.description||'').replace(/<br\s*\/?>/gi,' ').replace(/<[^>]*>/g,' ')}));renderAnimeGrid('animeResults',results);if(!results.length)showEmpty('animeResults','Aucun résultat pour « '+term+' ».');}
  catch(e){showEmpty('animeResults','La recherche est momentanément indisponible. Réessaie dans un instant.',true);}
}
function filterAnime(genre){showPage('explore');$('animeSearch').value='';const map={Adventure:'Adventure',Action:'Action',Fantasy:'Fantasy',Comedy:'Comedy'};const wanted=map[genre]||genre;const filtered=animeData.filter(a=>a.genres.includes(wanted));renderAnimeGrid('animeResults',filtered);if(!filtered.length)showEmpty('animeResults','Aucun résultat dans cette catégorie pour le moment.');}
function openAnime(anime){
  showPage('animeDetailPage');const box=$('animeDetails');box.replaceChildren();
  const layout=document.createElement('div');layout.className='detail-layout';const img=document.createElement('img');img.src=anime.image;img.alt='Affiche de '+anime.title;
  const content=document.createElement('div');const title=document.createElement('h2');title.textContent=anime.title;const meta=document.createElement('p');meta.className='muted';meta.textContent=[anime.year,anime.format,anime.episodes?anime.episodes+' épisodes':'',anime.score?'Note '+(anime.score/10).toFixed(1)+'/10':''].filter(Boolean).join(' • ');const desc=document.createElement('p');desc.textContent=anime.description||'Aucune description disponible.';desc.style.lineHeight='1.7';const genres=document.createElement('div');(anime.genres||[]).forEach(g=>{const tag=document.createElement('span');tag.className='tag';tag.textContent=g;genres.append(tag)});content.append(title,meta,desc,genres);layout.append(img,content);box.append(layout);
}

// Profil local
function readJSON(key,fallback){try{const value=JSON.parse(localStorage.getItem(key)||JSON.stringify(fallback));return value??fallback}catch{return fallback}}
function loadProfile(){const user=readJSON('swUser',{});$('profileName').value=user.name||''}
function saveProfile(){const name=$('profileName').value.trim();if(!name){$('profileStatus').textContent='Entre un pseudo avant de sauvegarder.';return}localStorage.setItem('swUser',JSON.stringify({name}));$('profileStatus').textContent='Profil enregistré sur cet appareil.'}

// Salons : interface communautaire locale. Le partage multi-appareils viendra avec Supabase.
function getRooms(){const rooms=readJSON('swRooms',[]);return Array.isArray(rooms)?rooms:[]}
function saveRooms(rooms){localStorage.setItem('swRooms',JSON.stringify(rooms))}
function generateCode(){const chars='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';let code='';for(let i=0;i<6;i++)code+=chars[Math.floor(Math.random()*chars.length)];return code}
function renderRoomAnimeMosaic(){
  const host=$('roomAnimeMosaic');
  const picks=featuredRoomAnime;
  if(host){host.replaceChildren();const labels=['The Apothecary Diaries','STEEL BALL RUN','Firefly Wedding','Tokyo Revengers'];
    labels.forEach((label,index)=>{const anime=picks[index];const character=(featuredRoomCharactersByAnime[index]||[])[0]||null;const tile=document.createElement('div');tile.className='room-mosaic-poster';
      const image=character?.image||anime?.image;
      if(image){const img=document.createElement('img');img.loading='lazy';img.src=image;img.alt=character?('Personnage de '+character.anime+' : '+character.name):('Affiche de '+(anime?.title||label));img.onerror=()=>{img.remove();tile.classList.add('poster-unavailable')};tile.append(img);}
      else tile.classList.add('poster-unavailable');
      const title=document.createElement('span');title.textContent=character?.name||anime?.title||label;tile.append(title);host.append(tile);
    });
  }
  const createArt=$('createRoomArt'),joinArt=$('joinRoomArt');
  // Visuels de secours réels : ils restent visibles même si l'API AniList ne répond pas.
  const onePieceFallback='https://www.megazap.fr/photo/art/grande/87617838-62132569.jpg?v=1743577339';
  const apothecaryFallback='https://static.animecorner.me/2024/12/1733760932-7523c484938f862d68041cbd2d84f55c.jpg';
  if(createArt&&!createArt.getAttribute('src')){createArt.src=onePieceFallback;createArt.alt='Visuel promotionnel One Piece';}
  if(joinArt&&!joinArt.getAttribute('src')){joinArt.src=apothecaryFallback;joinArt.alt='Visuel promotionnel The Apothecary Diaries';}
  [createArt,joinArt].forEach((img)=>{if(img){img.onerror=()=>{img.style.opacity='0';img.parentElement?.classList.add('image-fallback');};}});
  const onePiece=featuredOnePiece||animeData.find(a=>/one piece/i.test(a.title))||null;
  const apothecary=featuredRoomAnime.find(a=>/apothecary diaries|kusuriya/i.test(a.title));
  if(createArt&&onePiece?.banner){createArt.src=onePiece.banner;createArt.alt='Visuel officiel de One Piece';}
  else if(createArt&&onePiece?.image){createArt.src=onePiece.image;createArt.alt='Affiche officielle de One Piece';}
  if(joinArt&&apothecary?.image){joinArt.src=apothecary.image;joinArt.alt='Affiche officielle de '+apothecary.title;}
}

function createRoom(){const name=$('roomName').value.trim();if(!name){$('roomStatus').textContent='Entre un nom pour ton salon.';return}const rooms=getRooms();let code=generateCode();while(rooms.some(r=>r.code===code))code=generateCode();rooms.push({name,code,description:'Un espace pour partager nos passions anime.',messages:[],createdAt:Date.now()});saveRooms(rooms);$('roomName').value='';$('roomStatus').textContent='Ton salon a été créé !';currentRoomCode=code;renderRooms();openRoom(code)}
function renderRooms(){const list=$('roomList');if(!list)return;list.replaceChildren();const rooms=getRooms();$('roomCount').textContent=rooms.length+' '+(rooms.length>1?'salons':'salon');if(!rooms.length){const empty=document.createElement('div');empty.className='empty room-empty';empty.innerHTML='<strong>Aucun salon pour le moment</strong><br>Crée ton premier espace et invite tes amis avec son code.';list.append(empty);return}rooms.slice().reverse().forEach(room=>{const card=document.createElement('article');card.className='room-card';const cover=document.createElement('div');cover.className='room-cover';const coverAnime=(animeData||[]).filter(a=>a.image);if(coverAnime.length){const pick=coverAnime[(rooms.length+rooms.indexOf(room))%coverAnime.length];cover.style.backgroundImage='linear-gradient(90deg,#100b20bb,#100b2055),url("'+pick.image.replace(/"/g,'%22')+'")';cover.style.backgroundSize='cover';cover.style.backgroundPosition='center 35%'}const mark=document.createElement('div');mark.className='room-cover-mark';mark.innerHTML='<svg class="community-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3.5 19v-1.2A4.3 4.3 0 0 1 7.8 13.5h2.4a4.3 4.3 0 0 1 4.3 4.3V19"/><path d="M16 5.3a3 3 0 0 1 0 5.8M17 13.8a4.2 4.2 0 0 1 3.5 4.1V19"/></svg>';cover.append(mark);const body=document.createElement('div');body.className='room-card-body';const title=document.createElement('h3');title.textContent=room.name;const desc=document.createElement('p');desc.textContent=room.description||'Un espace pour partager vos passions anime.';const meta=document.createElement('div');meta.className='room-card-meta';const member=document.createElement('span');member.textContent='1 membre · local';const code=document.createElement('span');code.textContent='Code '+room.code;meta.append(member,code);const actions=document.createElement('div');actions.className='room-card-actions';const open=document.createElement('button');open.className='btn primary';open.textContent='Ouvrir le salon';open.onclick=()=>openRoom(room.code);const copy=document.createElement('button');copy.className='btn secondary';copy.textContent='Copier le code';copy.onclick=()=>copyRoomCode(room.code);actions.append(open,copy);body.append(title,desc,meta,actions);card.append(cover,body);list.append(card)})}
async function copyRoomCode(code){try{await navigator.clipboard.writeText(code);$('roomStatus').textContent='Code copié : '+code}catch{$('roomStatus').textContent='Code à partager : '+code}}
function joinRoom(){const code=$('roomCode').value.trim().toUpperCase();if(!code){$('joinStatus').textContent='Entre un code d’invitation.';return}const room=getRooms().find(r=>r.code===code);if(!room){$('joinStatus').textContent='Salon introuvable sur cet appareil. Le partage entre téléphones sera disponible avec Supabase.';return}$('joinStatus').textContent='Salon trouvé !';$('roomCode').value='';openRoom(code)}
function openRoom(code){const room=getRooms().find(r=>r.code===code);if(!room)return;currentRoomCode=code;$('roomDirectory').hidden=true;$('roomDetail').hidden=false;$('roomDetailName').textContent=room.name;$('roomDetailDescription').textContent=room.description||'Un espace pour partager nos passions anime.';$('roomDetailCode').textContent=room.code;const user=readJSON('swUser',{});$('roomOwnerName').textContent=user.name||'Toi';$('roomOwnerAvatar').textContent=(user.name||'S').trim().charAt(0).toUpperCase();renderRoomMessages();window.scrollTo(0,0)}
function backToRooms(){$('roomDetail').hidden=true;$('roomDirectory').hidden=false;renderRooms();window.scrollTo(0,0)}
function selectRoom(code){openRoom(code);showPage('rooms')}
async function copyCurrentRoomCode(){const room=getRooms().find(r=>r.code===currentRoomCode);if(room)await copyRoomCode(room.code)}
function renderRoomMessages(){const box=$('roomChat');if(!box)return;const room=getRooms().find(r=>r.code===currentRoomCode);box.replaceChildren();if(!room){const empty=document.createElement('div');empty.className='muted';empty.textContent='Ouvre un salon pour commencer.';box.append(empty);return}const messages=Array.isArray(room.messages)?room.messages:[];if(!messages.length){const empty=document.createElement('div');empty.className='muted';empty.textContent='Bienvenue dans '+room.name+' ! Lance la discussion.';box.append(empty)}messages.forEach(m=>{const line=document.createElement('div');line.className='chat-message';const who=document.createElement('strong');who.textContent=(m.name||'Membre')+' : ';const body=document.createElement('span');body.textContent=m.text||'';const time=document.createElement('small');time.textContent=' • '+new Date(m.time||Date.now()).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});line.append(who,body,time);box.append(line)});box.scrollTop=box.scrollHeight}
function sendRoomMessage(){const text=$('roomChatInput').value.trim();if(!text)return;const rooms=getRooms();const room=rooms.find(r=>r.code===currentRoomCode);if(!room){$('roomChatStatus').textContent='Ouvre un salon avant d’écrire.';return}room.messages=Array.isArray(room.messages)?room.messages:[];const user=readJSON('swUser',{});room.messages.push({name:user.name||'Membre',text,time:Date.now()});saveRooms(rooms);$('roomChatInput').value='';$('roomChatStatus').textContent='Message enregistré sur cet appareil.';renderRoomMessages();renderChat()}
function renderChat(){const box=$('watchChat');if(!box)return;const room=getRooms().find(r=>r.code===currentRoomCode);box.replaceChildren();if(!room){const msg=document.createElement('div');msg.className='muted';msg.textContent='Ouvre un salon depuis la page Salons pour afficher sa discussion.';box.append(msg);$('chatRoomLabel').textContent='Aucun salon sélectionné.';return}$('chatRoomLabel').textContent='Salon : '+room.name+' • Code : '+room.code;const messages=Array.isArray(room.messages)?room.messages:[];if(!messages.length){const empty=document.createElement('div');empty.className='muted';empty.textContent='Aucun message pour le moment. Lance la discussion !';box.append(empty)}messages.forEach(m=>{const line=document.createElement('div');line.className='chat-message';const who=document.createElement('strong');who.textContent=(m.name||'Membre')+' : ';const body=document.createElement('span');body.textContent=m.text||'';const time=document.createElement('small');time.textContent=' • '+new Date(m.time||Date.now()).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});line.append(who,body,time);box.append(line)});box.scrollTop=box.scrollHeight}
function sendMessage(){const text=$('chatInput').value.trim();if(!text)return;if(!currentRoomCode){$('chatStatus').textContent='Ouvre d’abord un salon.';return}const rooms=getRooms();const room=rooms.find(r=>r.code===currentRoomCode);if(!room){$('chatStatus').textContent='Ce salon est introuvable.';return}room.messages=Array.isArray(room.messages)?room.messages:[];const user=readJSON('swUser',{});room.messages.push({name:user.name||'Membre',text,time:Date.now()});saveRooms(rooms);$('chatInput').value='';$('chatStatus').textContent='Message enregistré sur cet appareil.';renderChat();renderRoomMessages()}

function loadVideo(){const raw=$('videoUrl').value.trim();if(!raw){$('videoStatus').textContent='Ajoute un lien vidéo.';return}let url;try{url=new URL(raw)}catch{$('videoStatus').textContent='Ce lien ne semble pas valide.';return}if(!['http:','https:'].includes(url.protocol)){$('videoStatus').textContent='Utilise un lien commençant par https:// ou http://.';return}const opened=window.open(url.href,'_blank','noopener,noreferrer');$('videoStatus').textContent=opened?'Lien ouvert dans un nouvel onglet.':'Le navigateur a bloqué la fenêtre. Autorise les fenêtres contextuelles pour ce site.';$('videoArea').textContent='La vidéo s’ouvre depuis la source indiquée. La lecture synchronisée n’est pas encore disponible.'}

// Démarrage
loadProfile();renderRooms();renderRoomAnimeMosaic();loadRoomFeaturedAnimes().catch(()=>{});loadAnimes();
</script>

